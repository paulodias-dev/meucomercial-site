{
  "name": "meu-comercial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run test:radio && npm run test:journeys && npm run test:portal && npm run test:showcase && npm run test:compliance && npm run test:indoor-catalog && npm run test:acquisition && npm run test:contracts && npm run test:indoor-proposal-response && npm run test:indoor-checkout && npm run test:indoor-provision-status && npm run test:indoor-operation-progress && npm run test:indoor-editorial-progress && npm run test:indoor-player-reports && npm run test:indoor-financial-guidance && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:radio": "node --test scripts/test-radio-guide.mjs",
    "test:journeys": "node --test scripts/test-audience-journeys.mjs",
    "test:portal": "node --test scripts/test-client-portal.mjs",
    "test:http": "node --test scripts/test-site-http.mjs",
    "test:browser": "node --test scripts/test-site-browser.mjs",
    "test:showcase": "node --test scripts/test-showcase-contracts.mjs",
    "test:compliance": "node --test scripts/test-site-compliance.mjs",
    "test:indoor-catalog": "node --test scripts/test-indoor-catalog.mjs",
    "test:acquisition": "node --test scripts/test-acquisition-journey.mjs",
    "test:acquisition:browser": "node --test scripts/test-acquisition-browser.mjs",
    "test:contracts": "node --test scripts/test-indoor-contracts.mjs",
    "test:indoor-proposal-response": "node --test scripts/test-indoor-proposal-response.mjs",
    "test:indoor-checkout": "node --test scripts/test-indoor-checkout.mjs",
    "test:indoor-provision-status": "node --test scripts/test-indoor-provision-status.mjs",
    "test:indoor-operation-progress": "node --test scripts/test-indoor-operation-progress.mjs",
    "test:indoor-editorial-progress": "node --test scripts/test-indoor-editorial-progress.mjs",
    "test:indoor-player-reports": "node --test scripts/test-indoor-player-reports.mjs",
    "test:indoor-financial-guidance": "node --test scripts/test-indoor-financial-guidance.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
